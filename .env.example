# Data directory (must be persistent in production — mounted volume)
EASYLINK_DATA_DIR=/var/easylink/data

# Comments store (JSON file; separate from Excel upload)
COMMENTS_STORE_PATH=

# Display timezone for comment timestamps (IANA name)
APP_TZ=Asia/Riyadh

# Keep last N daily comment backup files
COMMENTS_BACKUP_KEEP=14

PORT=8501
HOST=0.0.0.0
NODE_ENV=production
COOKIE_SECURE=true
